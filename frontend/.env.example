# ============================================================================
# UV3 Platform - Variables de entorno (plantilla)
# Copia este archivo a .env.local y completa los valores reales.
# En Vercel estas variables ya están configuradas: puedes traerlas con
#   npx vercel login
#   npx vercel env pull frontend/.env.local
# ============================================================================

# --- Requeridas: Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Requerida por la app: URL pública del sitio ---
# En local: http://localhost:3000  |  En Vercel: https://<tu-dominio>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Opcionales (solo si ejecutas tareas administrativas/servidor) ---
# Clave de servicio de Supabase. NUNCA debe exponerse al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa a PostgreSQL (para migraciones/verificación).
DATABASE_URL=
